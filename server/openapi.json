    "/api/v1/contracts/upload": {
      "post": {
        "tags": [
          "contracts"
        ],
        "summary": "Upload Contract",
        "description": "一期支持 .pdf/.txt（进入分析）与图片（存档，OCR 二期）。文件一律先落 LocalStorage，二期换 OSS。",
        "operationId": "upload_contract_api_v1_contracts_upload_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_contract_api_v1_contracts_upload_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractOut"
                }
