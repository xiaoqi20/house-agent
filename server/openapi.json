        ],
        "title": "Body_upload_contract_api_v1_contracts_upload_post"
      },
      "ChatReply": {
        "properties": {
          "cite": {
            "type": "string",
            "title": "Cite"
          },
          "paras": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Paras"
          },
          "cites": {
            "items": {
              "$ref": "#/components/schemas/Cite"
            },
            "type": "array",
            "title": "Cites"
          },
          "contract_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Contract Id"
          },
          "mode": {
            "type": "string",
            "enum": [
              "llm",
              "rules"
            ],
            "title": "Mode",
            "default": "rules"
          },
          "degraded": {
            "type": "boolean",
            "title": "Degraded",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "cite",
          "paras"
        ],
        "title": "ChatReply"
      },
