                  "title": "Response List Contracts Api V1 Contracts Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "contracts"
        ],
        "summary": "Create Contract",
        "operationId": "create_contract_api_v1_contracts_post",
