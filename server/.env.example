# RentGraph 后端环境变量（复制为 .env 后按需修改；.env 不入库）
# 数据库：默认 SQLite（零依赖本地开发）；生产按选型文档指向 Postgres 18
DATABASE_URL=sqlite+aiosqlite:///./rentgraph.db
# DATABASE_URL=postgresql+asyncpg://rentgraph:rentgraph@localhost:5433/rentgraph

SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=120

# 临时工作台有效期（小时），到期返回 410 WORKSPACE_EXPIRED
WORKSPACE_TTL_HOURS=72

# LLM：mock = 全部确定性规则（不联网，测试默认）；openai = LangChain ChatOpenAI 兼容接口
LLM_PROVIDER=mock
LLM_MODEL=qwen3.8-flash
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=1

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50
